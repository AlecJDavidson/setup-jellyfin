# Copy to `.env` and edit. These values are read by docker-compose.yml.
# Get your user/group ids with:  id -u     and     id -g

# Track the latest 10.x release. Other options: latest, 10.11, 10.11.0.
JELLYFIN_VERSION=10

# Timezone (IANA name), e.g. America/New_York, Europe/London, Asia/Tokyo.
TZ=Etc/UTC

# Run as this host user/group so mounted media is readable/writable. Adjust to `id -u` / `id -g`.
PUID=1000
PGID=1000

# Where the container keeps its configuration and cache.
JELLYFIN_CONFIG=/var/lib/jellyfin
JELLYFIN_CACHE=/var/cache/jellyfin

# Your media folder on the host. Mount read-only by default.
# Add extra libraries by editing the `volumes:` block in docker-compose.yml.
MEDIA_DIR=/media

# External port for the web UI.
JELLYFIN_PORT=8096
